# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill it in. Never commit .env.local.
# On Vercel, add the same keys under Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string.
#   Local (docker compose up -d):  postgres://acestar:acestar@localhost:5432/acestar
#   Neon (production):             use the *pooled* string, host contains "-pooler", with ?sslmode=require
# Leave empty to run the public site from the JSON files in src/data (admin needs a database).
DATABASE_URL=postgres://acestar:acestar@localhost:5432/acestar

# Admin login (/admin). Only one admin account, defined here.
ADMIN_EMAIL=admin@acestar.my
# Generate with:  npm run admin:password -- "your-strong-password"
ADMIN_PASSWORD_HASH=

# Signs the admin session cookie. At least 32 random characters.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it signs everyone out.
SESSION_SECRET=

# Image uploads from /admin.
#   Empty  → files are saved to public/uploads (local development only).
#   Vercel → create a Blob store (Storage tab) and it adds this token automatically.
BLOB_READ_WRITE_TOKEN=
